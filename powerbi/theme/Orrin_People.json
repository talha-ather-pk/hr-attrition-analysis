{
  "name": "Orrin People",
  "dataColors": [
    "#3B2F80",
    "#8B7FD1",
    "#F2795B",
    "#2E9E7A",
    "#E8A33D",
    "#5BA4CF",
    "#B9B3D9",
    "#C8364B"
  ],
  "foreground": "#1F1B33",
  "foregroundNeutralSecondary": "#6B6785",
  "foregroundNeutralTertiary": "#9A96B0",
  "background": "#FFFFFF",
  "backgroundLight": "#F1EEF8",
  "backgroundNeutral": "#E4E0F0",
  "tableAccent": "#3B2F80",
  "good": "#2E9E7A",
  "neutral": "#E8A33D",
  "bad": "#C8364B",
  "maximum": "#3B2F80",
  "center": "#8B7FD1",
  "minimum": "#EDEAF7",
  "null": "#FFFFFF",
  "hyperlink": "#3B2F80",
  "visitedHyperlink": "#3B2F80",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F1B33"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F1B33"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F1B33"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B6785"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E0F0"
              }
            },
            "radius": 10,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 10,
            "left": 14,
            "right": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#9A96B0"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineStyle": "dotted",
            "labelColor": {
              "solid": {
                "color": "#6B6785"
              }
            },
            "fontSize": 9,
            "concatenateLabels": false,
            "axisLineColor": {
              "solid": {
                "color": "#E4E0F0"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#EEEBF5"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#6B6785"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "labelColor": {
              "solid": {
                "color": "#6B6785"
              }
            },
            "fontSize": 9,
            "showTitle": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "fontSize": 9
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2.5
          }
        ],
        "visualTooltip": [
          {
            "titleFontColor": {
              "solid": {
                "color": "#6B6785"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E4E0F0"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#F1EEF8"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F4FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#ECE9F4"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "alignment": "center",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#6B6785"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEEBF5"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E4E0F0"
              }
            },
            "rowPadding": 5
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#6B6785"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1EEF8"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FBFAFE"
              }
            },
            "fontSize": 9
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "backColor": {
              "solid": {
                "color": "#F1EEF8"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#1F1B33"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEEBF5"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E4E0F0"
              }
            },
            "rowPadding": 5
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#6B6785"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1EEF8"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "showExpandCollapseButtons": false,
            "legacyStyleDisabled": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ],
        "subTotals": [
          {
            "fontFamily": "Segoe UI Semibold",
            "backgroundColor": {
              "solid": {
                "color": "#F1EEF8"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#C9C3E6"
              }
            },
            "textSize": 7.5,
            "fontFamily": "Segoe UI Semibold",
            "outlineStyle": 0
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F1B33"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 9,
            "outlineStyle": 0
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    }
  }
}
