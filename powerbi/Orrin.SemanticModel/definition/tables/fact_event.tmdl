	partition fact_event = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(File.Contents(DataFolder & "fact_event.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"employee_id", "effective_date", "event_type", "department", "job_title", "level", "work_mode", "annual_salary", "manager"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"employee_id", type text}, {"effective_date", type date}, {"event_type", type text}, {"department", type text}, {"job_title", type text}, {"level", Int64.Type}, {"work_mode", type text}, {"annual_salary", type number}, {"manager", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
