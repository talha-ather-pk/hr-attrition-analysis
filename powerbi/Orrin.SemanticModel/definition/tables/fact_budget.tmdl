table fact_budget
	lineageTag: a959051b-bf0e-5e39-8d61-bf04b12e34d4

	column month_date
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: a4eae524-3d5d-5455-b754-3a29353bd6ac
		summarizeBy: none
		sourceColumn: month_date

		annotation SummarizationSetBy = User

	column department
		dataType: string
		isHidden
		lineageTag: c27f523f-a0be-58ec-bb60-1006562d0aba
		summarizeBy: none
		sourceColumn: department

		annotation SummarizationSetBy = User

	column budget_fte
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d5206959-488d-5707-a5e7-8723041ac0a9
		summarizeBy: none
		sourceColumn: budget_fte

		annotation SummarizationSetBy = User

	partition fact_budget = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_budget.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"month_date", "department", "budget_fte"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"month_date", type date}, {"department", type text}, {"budget_fte", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
