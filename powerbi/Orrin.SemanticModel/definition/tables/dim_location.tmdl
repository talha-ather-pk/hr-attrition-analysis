table dim_location
	lineageTag: 01d02deb-e434-500f-88f5-4b8a299c7e65

	column location
		dataType: string
		isKey
		sortByColumn: loc_order
		lineageTag: 34344f8f-337e-5e19-8242-c26df25c3b2a
		summarizeBy: none
		sourceColumn: location

		annotation SummarizationSetBy = User

	column loc_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e07ba8e4-db90-5038-924d-cfb9f68a30db
		summarizeBy: none
		sourceColumn: loc_order

		annotation SummarizationSetBy = User

	partition dim_location = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_location.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"location", "loc_order"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"location", type text}, {"loc_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
