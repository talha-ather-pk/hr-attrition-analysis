	partition fact_exit = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_exit.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"employee_id", "interview_month", "department", "primary_reason", "would_return", "comment", "on_high_overtime", "below_band", "promotion_stalled"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"employee_id", type text}, {"interview_month", type date}, {"department", type text}, {"primary_reason", type text}, {"would_return", type text}, {"comment", type text}, {"on_high_overtime", Int64.Type}, {"below_band", Int64.Type}, {"promotion_stalled", Int64.Type}}, "en-US"),
				    Ord_reason_order = Table.AddColumn(Typed, "reason_order", each if [primary_reason] = null then null else List.PositionOf({"Better opportunity", "Pay", "Career progression", "Workload / burnout", "Personal / relocation", "Role not as expected", "Manager relationship", "Flexibility / remote work", "Further study"}, [primary_reason]) + 1, Int64.Type)
				in
				    Ord_reason_order

	annotation PBI_ResultType = Table
