table findings
	lineageTag: 71d39d14-4cb6-5ea1-8ce4-97ad97c07a23

	column key
		dataType: string
		lineageTag: 395db499-9dd7-57d6-9d95-db843ce2ae4a
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = User

	column value
		dataType: double
		isHidden
		lineageTag: 65d874c9-4008-5b60-b015-dd291169c6dd
		summarizeBy: none
		sourceColumn: value

		annotation SummarizationSetBy = User

	partition findings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "findings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "value"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"key", type text}, {"value", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
