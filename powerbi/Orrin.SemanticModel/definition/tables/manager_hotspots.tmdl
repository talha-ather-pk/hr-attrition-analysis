	partition manager_hotspots = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "manager_hotspots.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"manager_id", "manager", "department", "employment_status", "person_months", "resignations", "expected", "ratio_shrunk", "excess_resignations", "manager_support", "hotspot", "status", "true_bad_manager"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"manager_id", type text}, {"manager", type text}, {"department", type text}, {"employment_status", type text}, {"person_months", Int64.Type}, {"resignations", Int64.Type}, {"expected", type number}, {"ratio_shrunk", type number}, {"excess_resignations", type number}, {"manager_support", type number}, {"hotspot", Int64.Type}, {"status", type text}, {"true_bad_manager", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
