	partition scenarios = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "scenarios.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"order", "scenario", "action", "people", "avoided_resignations", "annual_benefit", "annual_cost", "net_annual_benefit", "roi_pct", "recommended"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"order", Int64.Type}, {"scenario", type text}, {"action", type text}, {"people", type number}, {"avoided_resignations", type number}, {"annual_benefit", type number}, {"annual_cost", type number}, {"net_annual_benefit", type number}, {"roi_pct", type number}, {"recommended", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
