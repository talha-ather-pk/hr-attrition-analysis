				    Typed = Table.TransformColumnTypes(Blanks, {{"level", Int64.Type}, {"level_name", type text}, {"recruitment_pct", type number}, {"vacancy_months", type number}, {"vacancy_cover_pct", type number}, {"ramp_months", type number}, {"ramp_loss_pct", type number}, {"team_time_pct", type number}, {"cost_share_of_salary", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
