	partition cost_assumptions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "cost_assumptions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"level", "level_name", "recruitment_pct", "vacancy_months", "vacancy_cover_pct", "ramp_months", "ramp_loss_pct", "team_time_pct", "cost_share_of_salary"}),
