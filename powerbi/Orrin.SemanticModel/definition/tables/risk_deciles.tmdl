table risk_deciles
	lineageTag: 90397303-8f1d-535f-bfc0-a4ae59d64c49

	column decile
		dataType: int64
		formatString: 0
		lineageTag: 28a4891e-9cba-5510-bfa8-6c0cc0d1c208
		summarizeBy: none
		sourceColumn: decile

		annotation SummarizationSetBy = User

	column people
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e6dc9a35-66e2-567a-81cd-f7e7457fd53d
		summarizeBy: none
		sourceColumn: people

		annotation SummarizationSetBy = User

	column predicted_pct
		dataType: double
		isHidden
		lineageTag: a0ca231d-ffea-57d9-89d1-f2e9f2225451
		summarizeBy: none
		sourceColumn: predicted_pct

		annotation SummarizationSetBy = User

	column actual_pct
		dataType: double
		isHidden
		lineageTag: c95f57a3-6b40-5e30-b958-dbe7084f4346
		summarizeBy: none
		sourceColumn: actual_pct

		annotation SummarizationSetBy = User

	column resigned
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c7aa27e5-4ed6-5989-989b-1364c02766f6
