	partition risk_deciles = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "risk_deciles.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"decile", "people", "predicted_pct", "actual_pct", "resigned", "cumulative_capture_pct"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"decile", Int64.Type}, {"people", Int64.Type}, {"predicted_pct", type number}, {"actual_pct", type number}, {"resigned", Int64.Type}, {"cumulative_capture_pct", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
