	partition dim_employee = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_employee.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"employee_id", "name", "employee_label", "gender", "hire_date", "termination_date", "termination_type", "employment_status", "is_rehire", "department", "job_title", "level", "location", "manager"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"employee_id", type text}, {"name", type text}, {"employee_label", type text}, {"gender", type text}, {"hire_date", type date}, {"termination_date", type date}, {"termination_type", type text}, {"employment_status", type text}, {"is_rehire", Int64.Type}, {"department", type text}, {"job_title", type text}, {"level", Int64.Type}, {"location", type text}, {"manager", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
