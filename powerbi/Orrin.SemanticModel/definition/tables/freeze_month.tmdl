table freeze_month
	lineageTag: 74608630-ea14-5c5e-b54e-919b58e904c8

	column month_date
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: edce1d83-faf8-569d-a0b0-3f2299dd6636
		summarizeBy: none
		sourceColumn: month_date

		annotation SummarizationSetBy = User

	column budget
		dataType: double
		isHidden
		lineageTag: 8cfb9ce0-a228-5c47-8c8c-69419054a707
		summarizeBy: none
		sourceColumn: budget

		annotation SummarizationSetBy = User

	column working
		dataType: double
		isHidden
		lineageTag: 4002fcbb-ec5d-588b-97b7-1b77c99227a1
		summarizeBy: none
		sourceColumn: working

		annotation SummarizationSetBy = User

	column vacancies
		dataType: double
		isHidden
		lineageTag: 6963ff31-854e-5a36-87e1-9eb79a5a2081
		summarizeBy: none
		sourceColumn: vacancies

		annotation SummarizationSetBy = User

	column vacancy_rate
		dataType: double
		isHidden
		lineageTag: f9e20450-ac40-5855-8a6a-e37456a78d7b
		summarizeBy: none
		sourceColumn: vacancy_rate

		annotation SummarizationSetBy = User

	partition freeze_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "freeze_month.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"month_date", "budget", "working", "vacancies", "vacancy_rate"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"month_date", type date}, {"budget", type number}, {"working", type number}, {"vacancies", type number}, {"vacancy_rate", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
