	partition fact_employee_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(File.Contents(DataFolder & "fact_employee_month.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"employee_id", "month_date", "department", "job_title", "level", "level_name", "location", "work_mode", "manager_id", "annual_salary", "band_mid", "compa_ratio", "overtime_hours", "overtime_3m", "months_since_promotion", "tenure_months", "age", "last_rating", "engagement", "workload", "manager_support", "growth", "absence_days", "rto_affected", "at_risk", "resigned", "terminated", "termination_type", "involuntary", "regrettable", "is_hire", "resignation_cost", "ot_high", "below_band", "promotion_stalled", "low_engagement", "first_year", "tenure_band", "compa_band", "overtime_band", "promo_band", "survey_status"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"employee_id", type text}, {"month_date", type date}, {"department", type text}, {"job_title", type text}, {"level", Int64.Type}, {"level_name", type text}, {"location", type text}, {"work_mode", type text}, {"manager_id", type text}, {"annual_salary", type number}, {"band_mid", type number}, {"compa_ratio", type number}, {"overtime_hours", type number}, {"overtime_3m", type number}, {"months_since_promotion", Int64.Type}, {"tenure_months", Int64.Type}, {"age", type number}, {"last_rating", type number}, {"engagement", type number}, {"workload", type number}, {"manager_support", type number}, {"growth", type number}, {"absence_days", Int64.Type}, {"rto_affected", Int64.Type}, {"at_risk", Int64.Type}, {"resigned", Int64.Type}, {"terminated", Int64.Type}, {"termination_type", type text}, {"involuntary", Int64.Type}, {"regrettable", Int64.Type}, {"is_hire", Int64.Type}, {"resignation_cost", type number}, {"ot_high", Int64.Type}, {"below_band", Int64.Type}, {"promotion_stalled", Int64.Type}, {"low_engagement", Int64.Type}, {"first_year", Int64.Type}, {"tenure_band", type text}, {"compa_band", type text}, {"overtime_band", type text}, {"promo_band", type text}, {"survey_status", type text}}, "en-US"),
				    Ord_tenure_order = Table.AddColumn(Typed, "tenure_order", each if [tenure_band] = null then null else List.PositionOf({"0-5 months", "6-11 months", "1-2 years", "2-5 years", "5-8 years", "8+ years"}, [tenure_band]) + 1, Int64.Type),
				    Ord_compa_order = Table.AddColumn(Ord_tenure_order, "compa_order", each if [compa_band] = null then null else List.PositionOf({"Under 85%", "85-90%", "90-95%", "95-105%", "Over 105%"}, [compa_band]) + 1, Int64.Type),
				    Ord_ot_order = Table.AddColumn(Ord_compa_order, "ot_order", each if [overtime_band] = null then null else List.PositionOf({"Under 10 h", "10-20 h", "20-30 h", "30 h +"}, [overtime_band]) + 1, Int64.Type),
				    Ord_promo_order = Table.AddColumn(Ord_ot_order, "promo_order", each if [promo_band] = null then null else List.PositionOf({"Under 18 months", "18-35 months", "3-5 years", "5+ years"}, [promo_band]) + 1, Int64.Type),
				    Ord_survey_order = Table.AddColumn(Ord_promo_order, "survey_order", each if [survey_status] = null then null else List.PositionOf({"Answered last quarter", "Stopped answering", "Never answered"}, [survey_status]) + 1, Int64.Type)
				in
				    Ord_survey_order

	annotation PBI_ResultType = Table
