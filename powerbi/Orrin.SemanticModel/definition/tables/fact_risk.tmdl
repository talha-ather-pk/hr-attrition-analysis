	partition fact_risk = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_risk.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"employee_id", "name", "department", "job_title", "level", "location", "manager", "annual_salary", "compa_ratio", "overtime_3m", "months_since_promotion", "tenure_months", "last_rating", "risk_score", "risk_band", "reasons", "cost_if_leaves", "rank"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"employee_id", type text}, {"name", type text}, {"department", type text}, {"job_title", type text}, {"level", Int64.Type}, {"location", type text}, {"manager", type text}, {"annual_salary", type number}, {"compa_ratio", type number}, {"overtime_3m", type number}, {"months_since_promotion", Int64.Type}, {"tenure_months", Int64.Type}, {"last_rating", type number}, {"risk_score", type number}, {"risk_band", type text}, {"reasons", type text}, {"cost_if_leaves", type number}, {"rank", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
